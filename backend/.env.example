# OpenSky OAuth2 API client (create one at https://opensky-network.org → Account → API Client).
# Leave both empty to use anonymous access (400 credits/day; raise OPENSKY_CACHE_TTL_MS to ~900000).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# How long to reuse OpenSky data (ms). India bbox costs 4 credits/call.
OPENSKY_CACHE_TTL_MS=120000

# AirLabs API key (https://airlabs.co)
AIRLABS_API_KEY=

# Comma-separated frontend origins allowed by CORS (empty = allow all, dev only)
ALLOWED_ORIGINS=

# ML service base URL. On Vercel Services this is injected by the binding: do NOT set it there.
# Local dev / Render: set it yourself.
ML_SERVICE_URL=http://localhost:8000
