{
    "name": "aerogrid-backend",
    "version": "1.0.0",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.js",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
    },
    "dependencies": {
        "axios": "^1.7.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.0",
        "esbuild": "^0.25.12",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
}
